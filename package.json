{
  "name": "deep-research-durable-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "deep-research": "dist/cli.js",
    "agent-server": "dist/agent-server/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent-server": {
      "types": "./dist/agent-server/index.d.ts",
      "import": "./dist/agent-server/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "cli": "node --experimental-strip-types src/cli.ts",
    "server": "npm run build && node dist/agent-server/cli.js",
    "test": "node --test-concurrency=1 --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "@langchain/protocol": "0.0.21",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
