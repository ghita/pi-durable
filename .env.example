# Choose openrouter, openai, or github-copilot.
MODEL_PROVIDER=openrouter

# OpenRouter (default provider)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional OpenRouter-compatible endpoint / app attribution.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=http://localhost

# Direct OpenAI alternative
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# GitHub Copilot alternative. Existing Copilot OAuth credentials can be read from
# COPILOT_AUTH_FILE (or the default app-data path); a provider token also works.
# COPILOT_MODEL=gpt-5-mini
# COPILOT_GITHUB_TOKEN=
# COPILOT_AUTH_FILE=

# Optional per-stage model IDs. Prefix with `openai:`, `openrouter:`, or
# `github-copilot:` to override the provider for that stage.
# RESEARCH_MODEL=
# COMPRESSION_MODEL=
# FINAL_REPORT_MODEL=

# Required for web research.
TAVILY_API_KEY=
TAVILY_TOPIC=general
TAVILY_MAX_RESULTS=5

# Execution limits.
ALLOW_CLARIFICATION=true
MAX_CONCURRENT_RESEARCH_UNITS=2
MAX_RESEARCHER_ITERATIONS=3
MAX_SUPERVISOR_ROUNDS=1
MAX_SEARCHES_PER_RESEARCHER=4
MAX_TOKENS=4096

# Optional read-only project skills directory.
# UI_REACT_SKILLS_DIR=
